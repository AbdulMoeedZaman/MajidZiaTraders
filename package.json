{
  "name": "MZTraders",
  "productName": "MZTraders",
  "version": "0.1.0",
  "private": true,
  "author": "MZTraders",
  "description": "MZTraders — parts-sales invoicing app (Electron + SQLite)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/run-unit.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "sample-data": "node tests/sample-data.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:portable": "npm run build && electron-builder --win --x64 --config.win.target=portable",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.mztraders.app",
    "productName": "MZTraders",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MZTraders",
      "uninstallDisplayName": "MZTraders",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/mztraders/"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
